# Réglages d'agent-pipeline : copier en .env (non suivi par git), adapter, puis `set -a; . ./.env; set +a`.
# Toutes les valeurs ci-dessous sont des exemples.

# ── Emplacements
AGENT_PIPELINE_HOME=/opt/agent-pipeline                  # ce dépôt
FLUX_HOME=/opt/agent-pipeline/vendor/flux                # le moteur flux (dépendance, voir le README)
BOUCLE_HOME=/opt/agent-pipeline/vendor/la-boucle-engine  # le moteur La boucle (dépendance : python3 -m boucle)

# ── Ce que le moteur flux lit pour jouer cette pipeline
FLUX_WORKFLOWS_DIR=/opt/agent-pipeline/workflows         # le graphe agent.json
FLUX_SKILLS_DIR=/opt/agent-pipeline/skills               # les consignes injectées aux agents
FLUX_VALIDATORS_PATH=/opt/agent-pipeline/validators      # les contrôles de fin d'étape
# FLUX_STATE_DIR=/var/lib/flux/state                     # état du moteur (défaut : <FLUX_HOME>/state)

# ── Runs
# AGENT_RUNS=/home/utilisateur/agent-runs                # défaut : workspace_root du graphe (~/agent-runs)

# ── Agents
# AGENT_MOTEUR=principal                                 # id d'un moteur de moteurs.json de flux (défaut : son `defaut`)
# AGENT_LIMITEUR=nice -n 10                              # préfixe des commandes lourdes (facultatif)

